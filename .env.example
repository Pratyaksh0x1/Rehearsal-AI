# ==============================================================================
# Rehearsal AI — Environment Configuration
# ==============================================================================

# 1. Database (Postgres on Neon or Supabase Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# 2. Authentication (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Product Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_project_api_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# 4. Code Execution Sandbox: Piston API (EMKC Piston)
# Free hosted or self-hosted Piston execution sandbox for Python, JS, TS, C++, Java
JUDGE_SERVICE_URL="https://emkc.org/api/v2/piston/execute"
JUDGE_API_KEY=""

# 5. Voice Engine: Gnani.ai (STT + TTS) - only the key is required.
# Do NOT set the URLs below unless Gnani tells you to; the code already defaults to the correct ones.
# (The old template pointed at asr.gnani.ai / tts.gnani.ai, which do not exist, so the voice agent never worked.)
GNANI_API_KEY="your-gnani-api-key"
# GNANI_STT_URL="https://api.vachana.ai/stt/v3"
# GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"
GNANI_LANGUAGE="en-IN"
# GNANI_VOICE="Pranav"          # fallback voice (Timbre v2.5 English: Pranav, Kaveri, Trupti, Devika, Shlok, Girish)
# GNANI_MODEL="timbre-v2.5"     # timbre-v2.5 or timbre-v3.0 (v2.0 is gone)

# 6. LLM Provider Configuration
# Choose primary provider: 'gemini' | 'openai' | 'grok'
LLM_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite"   # gemini-1.5-* is deprecated -> gemini-3.1-flash-lite

# OpenAI API (Fallback / Alternative)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# xAI Grok API (Fallback / Alternative)
GROK_API_KEY="your-grok-api-key"
GROK_MODEL="grok-beta"
