# ==============================================================================
# Rehearsal AI — Environment Configuration
# ==============================================================================

# 1. Database (Postgres on Neon or Supabase Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# 2. Authentication: Supabase Auth (Single Authentication System)
# All routes except "/" and "/auth/callback" require active Supabase authentication.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Product Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_project_api_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# 4. Code Execution Sandbox
# Built-in: Isolated local sandbox executes Python, JavaScript/Node, C++ (g++), and Java (javac).
# External/Self-hosted (Optional): Set JUDGE_SERVICE_URL to a Docker Piston instance or keyed Piston runner.
JUDGE_SERVICE_URL="https://emkc.org/api/v2/piston/execute"
JUDGE_API_KEY=""

# 5. Voice Engine: Gnani.ai (STT + TTS)
# API key is required for server-side Indian English voice models (timbre-v2.5).
GNANI_API_KEY="your-gnani-api-key"
# GNANI_STT_URL="https://api.vachana.ai/stt/v3"
# GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"
GNANI_LANGUAGE="en-IN"
# Fallback voice (Timbre v2.5 English: Pranav, Kaveri, Trupti, Devika, Shlok, Girish)
# GNANI_VOICE="Pranav"
# GNANI_MODEL="timbre-v2.5"

# 6. LLM Provider Configuration
# Choose primary provider: 'gemini' | 'deepseek' | 'openrouter' | 'grok'
LLM_PROVIDER="groq"

# Google Gemini API (Recommended: gemini-2.5-flash or gemini-3.1-flash-lite)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite"

# DeepSeek API (Alternative / Fallback)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# OpenRouter API (Alternative / Fallback)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="deepseek/deepseek-chat"

# Groq API
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"

# xAI Grok API (Alternative / Fallback)
GROK_API_KEY="your-grok-api-key"
GROK_MODEL="grok-4.7"
